[daemon]
log_file  = /var/log/sip-daemon.log
log_level = INFO

[sip]
bind_address = 0.0.0.0
bind_port    = 5060
; public_address = 1.2.3.4

[registration]
enabled  = true
server   = business2.voipgateway.org
port     = 5060
username = DEINE_RUFNUMMER
password = DEIN_PASSWORT
domain   = business2.voipgateway.org
expires  = 300

[handler]
handler_binary = python3
handler_script = /usr/local/share/sip-daemon/handler.py

[filemaker]
host     = dein-filemaker-server
database = DeineDatenbank
layout   = DeinLayout
script   = scrAnruflisteEinfuegenClient
username = api-benutzer
password = api-passwort
skip_ssl = false
